# Copy this to .env.prod and fill in real values before deploying.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Postgres
POSTGRES_USER=viduthalai
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=viduthalai

# Backend
DATABASE_URL=postgresql+asyncpg://viduthalai:change-this-to-a-strong-password@postgres:5432/viduthalai
REDIS_URL=redis://redis:6379/0

# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or: docker compose -f docker-compose.prod.yml run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Public origin(s) of your deployed frontend, comma-separated. Must match exactly (scheme + host).
CORS_ORIGINS=https://your-domain.com

# Port the container binds on 127.0.0.1 — your VPS nginx proxies to this.
BACKEND_PORT=8000

# Frontend
# Public URL browsers will call for the API — baked into the JS bundle at build time.
# If nginx proxies https://your-domain.com/api/* -> backend, use that. If the API
# is on its own subdomain instead, use that origin (no /api suffix) and proxy the root.
NEXT_PUBLIC_API_URL=https://your-domain.com/api
FRONTEND_PORT=3000
